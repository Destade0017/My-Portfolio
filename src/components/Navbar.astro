---
// Placeholder URLs for social links
const GITHUB_URL = "https://github.com/adesuyijohn";
const LINKEDIN_URL = "https://linkedin.com/in/adesuyijohn";

const pathname = Astro.url.pathname;
const isHome = pathname === "/";
---

<div class="container-custom">
  <div class="flex h-16 items-center justify-between gap-4">
    <!-- Brand / Logo -->
    <a 
      href="/" 
      class="text-h3 font-extrabold tracking-tight text-[var(--color-text-primary)] hover:text-[var(--color-accent-text)] transition-colors focus-visible:outline-none"
      aria-label="AJ Homepage"
    >
      AJ
    </a>

    <!-- Desktop Navigation Links -->
    <nav aria-label="Main Navigation" class="hidden md:flex items-center gap-6">
      <ul class="flex items-center gap-6 text-small font-medium list-none m-0 p-0">
        <li>
          <a 
            href="/" 
            class={`transition-colors hover:text-[var(--color-text-primary)] ${isHome ? 'text-[var(--color-text-primary)] font-semibold border-b-2 border-[var(--color-accent)] pb-1' : 'text-[var(--color-text-secondary)]'}`}
            aria-current={isHome ? "page" : undefined}
          >
            Home
          </a>
        </li>
        <li>
          <a 
            href="/#projects" 
            class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            Projects
          </a>
        </li>
        <li>
          <a 
            href="/#experience" 
            class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            Experience
          </a>
        </li>
        <li>
          <a 
            href="/#about" 
            class="text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            About
          </a>
        </li>
      </ul>

      <div class="h-4 w-px bg-[var(--color-border)]" aria-hidden="true"></div>

      <!-- Desktop Socials & Theme Toggle -->
      <div class="flex items-center gap-3">
        <a 
          href={GITHUB_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 text-meta text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          aria-label="GitHub Profile (opens in new tab)"
        >
          GitHub
        </a>
        <a 
          href={LINKEDIN_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="p-2 text-meta text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          aria-label="LinkedIn Profile (opens in new tab)"
        >
          LinkedIn
        </a>

        <!-- Theme Toggle Button -->
        <button
          id="theme-toggle-desktop"
          type="button"
          class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface)] p-2.5 text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-colors"
          aria-label="Switch to dark theme"
        >
          <!-- Sun Icon (shown in dark mode) -->
          <svg id="sun-icon-desktop" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <!-- Moon Icon (shown in light mode) -->
          <svg id="moon-icon-desktop" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Navigation Controls (Hamburger Button + Theme Toggle) -->
    <div class="flex items-center gap-2 md:hidden">
      <button
        id="theme-toggle-mobile"
        type="button"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface)] p-2.5 text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-colors"
        aria-label="Switch to dark theme"
      >
        <svg id="sun-icon-mobile" class="hidden h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="5"></circle>
          <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
        </svg>
        <svg id="moon-icon-mobile" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"></path>
        </svg>
      </button>

      <button
        id="mobile-menu-button"
        type="button"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface)] p-2.5 text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation menu"
      >
        <!-- Menu Icon -->
        <svg id="menu-open-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <!-- Close Icon -->
        <svg id="menu-close-icon" class="hidden h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div 
    id="mobile-menu" 
    class="hidden md:hidden border-t border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-6 space-y-4 rounded-b-[var(--radius-md)] shadow-lg"
  >
    <nav aria-label="Mobile Navigation">
      <ul class="flex flex-col gap-3 text-body font-medium list-none m-0 p-0">
        <li>
          <a 
            href="/" 
            class="block py-2 text-[var(--color-text-primary)] hover:text-[var(--color-accent-text)] transition-colors"
          >
            Home
          </a>
        </li>
        <li>
          <a 
            href="/#projects" 
            class="block py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            Projects
          </a>
        </li>
        <li>
          <a 
            href="/#experience" 
            class="block py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            Experience
          </a>
        </li>
        <li>
          <a 
            href="/#about" 
            class="block py-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
          >
            About
          </a>
        </li>
      </ul>
    </nav>

    <hr class="border-[var(--color-border)] my-4" />

    <div class="flex items-center gap-4 pt-2">
      <a 
        href={GITHUB_URL} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-meta text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
      >
        GitHub ↗
      </a>
      <a 
        href={LINKEDIN_URL} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-meta text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-colors"
      >
        LinkedIn ↗
      </a>
    </div>
  </div>
</div>

<script>
  // Clean, lightweight vanilla JS controller for theme toggle and mobile navigation
  document.addEventListener('DOMContentLoaded', () => {
    // Theme Controller Logic
    const themeToggleBtns = [
      document.getElementById('theme-toggle-desktop'),
      document.getElementById('theme-toggle-mobile')
    ].filter(Boolean) as HTMLButtonElement[];

    const updateThemeUI = (isDark: boolean) => {
      document.querySelectorAll('#sun-icon-desktop, #sun-icon-mobile').forEach(el => {
        el.classList.toggle('hidden', !isDark);
      });
      document.querySelectorAll('#moon-icon-desktop, #moon-icon-mobile').forEach(el => {
        el.classList.toggle('hidden', isDark);
      });

      themeToggleBtns.forEach(btn => {
        btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
      });
    };

    // Initial sync with document class
    const initialIsDark = document.documentElement.classList.contains('dark');
    updateThemeUI(initialIsDark);

    themeToggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateThemeUI(isDark);
      });
    });

    // Mobile Navigation Logic
    const menuBtn = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const openIcon = document.getElementById('menu-open-icon');
    const closeIcon = document.getElementById('menu-close-icon');

    if (menuBtn && mobileMenu && openIcon && closeIcon) {
      const toggleMenu = (show?: boolean) => {
        const isExpanded = show !== undefined ? show : menuBtn.getAttribute('aria-expanded') !== 'true';
        menuBtn.setAttribute('aria-expanded', String(isExpanded));
        mobileMenu.classList.toggle('hidden', !isExpanded);
        openIcon.classList.toggle('hidden', isExpanded);
        closeIcon.classList.toggle('hidden', !isExpanded);
      };

      menuBtn.addEventListener('click', () => toggleMenu());

      // Close mobile menu when clicking any link inside it
      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => toggleMenu(false));
      });

      // Close menu on Escape key press
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
          toggleMenu(false);
          menuBtn.focus();
        }
      });
    }
  });
</script>
