---
// Code snippets showcased in the interactive architecture spotlight
const SNIPPETS = {
  controller: {
    filename: "auth.controller.ts",
    lang: "typescript",
    description: "Production-ready async Express controller with custom error handling & JWT security",
    code: `import type { Request, Response, NextFunction } from "express";
import { AppError } from "../utils/AppError";
import { UserService } from "../services/user.service";
import { generateAuthToken } from "../utils/jwt";

/**
 * Handles user login with bcrypt validation and secure JWT generation.
 */
export const handleLogin = async (
  req: Request,
  res: Response,
  next: NextFunction
): Promise<void> => {
  const { email, password } = req.body;

  if (!email || !password) {
    return next(new AppError("Email and password are required.", 400));
  }

  // Query optimized user record by unique email index
  const user = await UserService.findByCredentials(email, password);
  if (!user) {
    return next(new AppError("Invalid email or credentials.", 401));
  }

  const token = generateAuthToken({
    id: user.id,
    role: user.role
  });

  res.status(200).json({
    status: "success",
    data: {
      user: { id: user.id, name: user.name, email: user.email },
      token
    }
  });
};`
  },
  schema: {
    filename: "schema-design.sql",
    lang: "sql",
    description: "Normalized PostgreSQL schema design with relational constraints & B-tree indexes",
    code: `-- Performance-indexed relational schema for Multi-Tenant Projects
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE NOT NULL,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(50) DEFAULT 'developer' CHECK (role IN ('admin', 'developer', 'viewer')),
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE projects (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    title VARCHAR(150) NOT NULL,
    status VARCHAR(50) DEFAULT 'active' CHECK (status IN ('active', 'archived')),
    metadata JSONB DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP
);

-- Compound index for high-frequency user-specific filtered queries
CREATE INDEX idx_projects_user_status ON projects (user_id, status);
CREATE INDEX idx_users_email ON users (email);`
  },
  curl: {
    filename: "api-healthcheck.sh",
    lang: "bash",
    description: "Simulated live API healthcheck request with latency metrics",
    code: `$ curl -s -X GET https://api.johnkorede.dev/v1/health | jq .

{
  "status": "operational",
  "system": "John Korede Portfolio API",
  "version": "1.4.0",
  "environment": "production",
  "metrics": {
    "uptime": "99.98%",
    "db_latency_ms": 14,
    "memory_usage_mb": 42.6
  },
  "engineer": {
    "name": "John Korede Adesuyi",
    "role": "Software Developer",
    "location": "Abuja, Nigeria",
    "open_to_work": true
  }
}`
  }
};
---

<section id="architecture" class="py-16 sm:py-24 border-b border-[var(--color-border)] space-y-8">
  <div class="max-w-2xl space-y-3">
    <div class="text-label text-[var(--color-accent-text)] font-mono tracking-widest">
      ENGINEERING SPOTLIGHT
    </div>
    <h2 class="text-h1 font-bold text-[var(--color-text-primary)] tracking-tight">
      Backend Architecture &amp; Code Showcase
    </h2>
    <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
      A direct look at my coding standards, API design patterns, and database structuring principles. Explore the source snippets or test out the interactive terminal below.
    </p>
  </div>

  <!-- Terminal Window Container -->
  <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[#10141d] text-slate-200 overflow-hidden shadow-xl font-mono text-xs sm:text-sm">
    <!-- Terminal Titlebar & Window Controls -->
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800 bg-[#0c0f17] px-4 py-3">
      <!-- Window Dots -->
      <div class="flex items-center gap-2">
        <span class="h-3 w-3 rounded-full bg-[#ff5f56] inline-block" aria-hidden="true"></span>
        <span class="h-3 w-3 rounded-full bg-[#ffbd2e] inline-block" aria-hidden="true"></span>
        <span class="h-3 w-3 rounded-full bg-[#27c93f] inline-block" aria-hidden="true"></span>
        <span class="ml-2 text-xs text-slate-400 hidden sm:inline">
          adesuyi@portfolio: ~/backend-core
        </span>
      </div>

      <!-- Action Button: Copy Code -->
      <button
        id="terminal-copy-btn"
        type="button"
        class="inline-flex items-center gap-1.5 rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800/80 px-2.5 py-1 text-xs text-slate-300 hover:text-white hover:border-slate-500 transition-colors cursor-pointer"
        aria-label="Copy active code snippet"
      >
        <svg id="term-copy-icon" xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
        </svg>
        <svg id="term-check-icon" xmlns="http://www.w3.org/2000/svg" class="hidden h-3.5 w-3.5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
        </svg>
        <span id="term-copy-text">Copy Code</span>
      </button>
    </div>

    <!-- Tab Bar -->
    <div class="flex flex-wrap items-center border-b border-slate-800 bg-[#0e121b] text-xs">
      <button
        type="button"
        class="tab-btn px-4 py-2.5 font-medium border-b-2 border-indigo-400 text-indigo-300 bg-slate-800/50 flex items-center gap-2 hover:text-white transition-colors cursor-pointer"
        data-tab="controller"
      >
        <span class="text-indigo-400">TS</span>
        auth.controller.ts
      </button>
      <button
        type="button"
        class="tab-btn px-4 py-2.5 font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-2 cursor-pointer"
        data-tab="schema"
      >
        <span class="text-emerald-400">SQL</span>
        schema-design.sql
      </button>
      <button
        type="button"
        class="tab-btn px-4 py-2.5 font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-2 cursor-pointer"
        data-tab="curl"
      >
        <span class="text-amber-400">CURL</span>
        api-healthcheck.sh
      </button>
      <button
        type="button"
        class="tab-btn px-4 py-2.5 font-medium border-b-2 border-transparent text-slate-400 hover:text-slate-200 transition-colors flex items-center gap-2 cursor-pointer"
        data-tab="interactive"
      >
        <span class="text-purple-400">&gt;_</span>
        Interactive CLI
      </button>
    </div>

    <!-- Tab Content 1: Controller Code -->
    <div id="tab-content-controller" class="tab-pane p-4 sm:p-6 overflow-x-auto">
      <div class="text-xs text-slate-400 mb-3 italic">
        // {SNIPPETS.controller.description}
      </div>
      <pre class="leading-relaxed"><code id="code-controller" class="text-slate-200">{SNIPPETS.controller.code}</code></pre>
    </div>

    <!-- Tab Content 2: Schema SQL -->
    <div id="tab-content-schema" class="tab-pane hidden p-4 sm:p-6 overflow-x-auto">
      <div class="text-xs text-slate-400 mb-3 italic">
        -- {SNIPPETS.schema.description}
      </div>
      <pre class="leading-relaxed"><code id="code-schema" class="text-slate-200">{SNIPPETS.schema.code}</code></pre>
    </div>

    <!-- Tab Content 3: Curl Healthcheck -->
    <div id="tab-content-curl" class="tab-pane hidden p-4 sm:p-6 overflow-x-auto">
      <div class="text-xs text-slate-400 mb-3 italic">
        # {SNIPPETS.curl.description}
      </div>
      <pre class="leading-relaxed"><code id="code-curl" class="text-emerald-400">{SNIPPETS.curl.code}</code></pre>
    </div>

    <!-- Tab Content 4: Interactive Live CLI -->
    <div id="tab-content-interactive" class="tab-pane hidden p-4 sm:p-6 space-y-4">
      <div class="text-xs text-slate-400 space-y-1">
        <p>Antigravity Terminal v2.4 &mdash; Type commands or click the shortcut chips below.</p>
        <p class="text-slate-500">Available: <span class="text-indigo-300">skills</span>, <span class="text-indigo-300">projects</span>, <span class="text-indigo-300">experience</span>, <span class="text-indigo-300">whoami</span>, <span class="text-indigo-300">contact</span>, <span class="text-indigo-300">clear</span></p>
      </div>

      <!-- Quick Command Chips for tap-to-run on mobile/desktop -->
      <div class="flex flex-wrap gap-2 pt-1">
        <button type="button" class="cli-chip rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800/80 px-2.5 py-1 text-xs text-indigo-300 hover:border-indigo-400 hover:text-white transition-colors cursor-pointer" data-cmd="whoami">whoami</button>
        <button type="button" class="cli-chip rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800/80 px-2.5 py-1 text-xs text-indigo-300 hover:border-indigo-400 hover:text-white transition-colors cursor-pointer" data-cmd="skills">skills</button>
        <button type="button" class="cli-chip rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800/80 px-2.5 py-1 text-xs text-indigo-300 hover:border-indigo-400 hover:text-white transition-colors cursor-pointer" data-cmd="projects">projects</button>
        <button type="button" class="cli-chip rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800/80 px-2.5 py-1 text-xs text-indigo-300 hover:border-indigo-400 hover:text-white transition-colors cursor-pointer" data-cmd="experience">experience</button>
        <button type="button" class="cli-chip rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800/80 px-2.5 py-1 text-xs text-indigo-300 hover:border-indigo-400 hover:text-white transition-colors cursor-pointer" data-cmd="contact">contact</button>
        <button type="button" class="cli-chip rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800/80 px-2.5 py-1 text-xs text-rose-300 hover:border-rose-400 hover:text-white transition-colors cursor-pointer" data-cmd="clear">clear</button>
      </div>

      <!-- Terminal Output Display -->
      <div id="cli-output" class="space-y-2.5 text-xs text-slate-300 min-h-[140px] max-h-[300px] overflow-y-auto pr-2 border-t border-slate-800 pt-3">
        <div>
          <span class="text-emerald-400">adesuyi@portfolio:~$</span>
          <span class="text-slate-100"> welcome</span>
          <p class="text-slate-400 mt-1 pl-4">Hello! I am John Adesuyi Korede, a Software Developer and Computer Science graduate. Type or tap <span class="text-indigo-400 font-semibold">'skills'</span> or <span class="text-indigo-400 font-semibold">'projects'</span> to explore!</p>
        </div>
      </div>

      <!-- Input Command Line -->
      <form id="cli-form" class="flex items-center gap-2 pt-2 border-t border-slate-800">
        <span class="text-emerald-400 select-none">adesuyi@portfolio:~$</span>
        <input
          type="text"
          id="cli-input"
          placeholder="type a command (e.g. skills)..."
          autocomplete="off"
          autocorrect="off"
          autocapitalize="off"
          spellcheck="false"
          class="flex-1 bg-transparent text-slate-100 text-xs focus:outline-none placeholder:text-slate-600"
        />
        <button
          type="submit"
          class="rounded-[var(--radius-sm)] border border-slate-700 bg-slate-800 px-3 py-1 text-xs text-slate-300 hover:text-white hover:border-indigo-400 transition-colors cursor-pointer"
        >
          Run
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // -------------------------------------------------------------
    // 1. Tab Switching Controller
    // -------------------------------------------------------------
    const tabBtns = document.querySelectorAll('.tab-btn');
    const tabPanes = document.querySelectorAll('.tab-pane');
    let currentTab = 'controller';

    const switchTab = (tabName: string) => {
      currentTab = tabName;
      tabBtns.forEach(btn => {
        const isSelected = btn.getAttribute('data-tab') === tabName;
        if (isSelected) {
          btn.classList.add('border-indigo-400', 'text-indigo-300', 'bg-slate-800/50');
          btn.classList.remove('border-transparent', 'text-slate-400');
        } else {
          btn.classList.remove('border-indigo-400', 'text-indigo-300', 'bg-slate-800/50');
          btn.classList.add('border-transparent', 'text-slate-400');
        }
      });

      tabPanes.forEach(pane => {
        if (pane.id === `tab-content-${tabName}`) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      });
    };

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tab = btn.getAttribute('data-tab');
        if (tab) switchTab(tab);
      });
    });

    // -------------------------------------------------------------
    // 2. Terminal Copy Code Button
    // -------------------------------------------------------------
    const copyBtn = document.getElementById('terminal-copy-btn');
    const copyIcon = document.getElementById('term-copy-icon');
    const checkIcon = document.getElementById('term-check-icon');
    const copyText = document.getElementById('term-copy-text');

    if (copyBtn && copyIcon && checkIcon && copyText) {
      copyBtn.addEventListener('click', async () => {
        let textToCopy = '';
        if (currentTab === 'controller') {
          textToCopy = document.getElementById('code-controller')?.textContent || '';
        } else if (currentTab === 'schema') {
          textToCopy = document.getElementById('code-schema')?.textContent || '';
        } else if (currentTab === 'curl') {
          textToCopy = document.getElementById('code-curl')?.textContent || '';
        } else {
          textToCopy = document.getElementById('cli-output')?.innerText || '';
        }

        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(textToCopy);
          } else {
            const ta = document.createElement('textarea');
            ta.value = textToCopy;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }

          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          copyText.textContent = 'Copied!';

          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            copyText.textContent = 'Copy Code';
          }, 2000);
        } catch (e) {
          console.error('Failed to copy snippet:', e);
        }
      });
    }

    // -------------------------------------------------------------
    // 3. Interactive Terminal Command Execution
    // -------------------------------------------------------------
    const cliForm = document.getElementById('cli-form') as HTMLFormElement | null;
    const cliInput = document.getElementById('cli-input') as HTMLInputElement | null;
    const cliOutput = document.getElementById('cli-output');
    const cliChips = document.querySelectorAll('.cli-chip');

    const COMMAND_RESPONSES: Record<string, string> = {
      whoami: `John Adesuyi Korede &mdash; Software Developer & Computer Science Graduate (Caleb University). Focused on backend architecture, REST APIs, and full-stack web products.`,
      skills: `<span class="text-indigo-400 font-bold">Languages:</span> JavaScript, TypeScript, SQL, HTML5, CSS3<br/>
<span class="text-indigo-400 font-bold">Backend & DB:</span> Node.js, Express, REST APIs, PostgreSQL, MongoDB<br/>
<span class="text-indigo-400 font-bold">Frontend:</span> React, Tailwind CSS, Vite, Astro, Svelte<br/>
<span class="text-indigo-400 font-bold">Tools:</span> Git, GitHub, Postman, Docker, Render, Vercel`,
      projects: `1. <span class="text-indigo-300 font-bold">Learnova</span> &mdash; Full-Stack Educational Platform (Node.js, Express, MongoDB, React)<br/>
2. <span class="text-indigo-300 font-bold">Rentra</span> &mdash; Modern Apartment & Property Rental Platform<br/>
3. <span class="text-indigo-300 font-bold">Reporting Tool</span> &mdash; Internal operational reporting dashboard (Ouranos Labs)`,
      experience: `&bull; <span class="text-emerald-400">Digital Support &amp; Social Media Intern</span> &mdash; Peniel Apartments (Sept 2026 &ndash; Present)<br/>
&bull; <span class="text-emerald-400">Software Engineering Intern</span> &mdash; Ouranos Labs (June 2025 &ndash; Nov 2025)<br/>
&bull; <span class="text-emerald-400">WordPress Developer Intern</span> &mdash; GAO Tek Inc. (July 2025 &ndash; Sept 2025)`,
      contact: `Email: <a href="mailto:destade45@gmail.com" class="text-indigo-300 underline">destade45@gmail.com</a><br/>
GitHub: <a href="https://github.com/Destade0017" target="_blank" class="text-indigo-300 underline">github.com/Destade0017 ↗</a><br/>
LinkedIn: <a href="https://www.linkedin.com/in/john-adesuyi-572012348" target="_blank" class="text-indigo-300 underline">linkedin.com/in/john-adesuyi ↗</a>`,
      help: `Available commands:<br/>
&nbsp;&bull; <span class="text-indigo-300 font-semibold">whoami</span> &mdash; Bio &amp; summary<br/>
&nbsp;&bull; <span class="text-indigo-300 font-semibold">skills</span> &mdash; Tech stack &amp; tools<br/>
&nbsp;&bull; <span class="text-indigo-300 font-semibold">projects</span> &mdash; Flagship applications<br/>
&nbsp;&bull; <span class="text-indigo-300 font-semibold">experience</span> &mdash; Career timeline<br/>
&nbsp;&bull; <span class="text-indigo-300 font-semibold">contact</span> &mdash; Email &amp; profiles<br/>
&nbsp;&bull; <span class="text-indigo-300 font-semibold">clear</span> &mdash; Clear output screen`
    };

    const runCommand = (rawCmd: string) => {
      if (!cliOutput) return;
      const cmd = rawCmd.trim().toLowerCase();
      if (!cmd) return;

      if (cmd === 'clear') {
        cliOutput.innerHTML = '';
        return;
      }

      const responseHtml = COMMAND_RESPONSES[cmd] || `Command not found: <span class="text-rose-400">${cmd}</span>. Type <span class="text-indigo-300 font-semibold">'help'</span> for list of commands.`;

      const block = document.createElement('div');
      block.className = 'mt-2 border-t border-slate-800/60 pt-2';
      block.innerHTML = `
        <div>
          <span class="text-emerald-400">adesuyi@portfolio:~$</span>
          <span class="text-slate-100 font-semibold"> ${cmd}</span>
        </div>
        <div class="text-slate-300 mt-1 pl-4 leading-relaxed">${responseHtml}</div>
      `;
      cliOutput.appendChild(block);
      cliOutput.scrollTop = cliOutput.scrollHeight;
    };

    if (cliForm && cliInput) {
      cliForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const cmd = cliInput.value;
        cliInput.value = '';
        runCommand(cmd);
      });
    }

    cliChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const cmd = chip.getAttribute('data-cmd');
        if (cmd) {
          switchTab('interactive');
          runCommand(cmd);
        }
      });
    });
  });
</script>
