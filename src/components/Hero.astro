---
const CONTACT_EMAIL = "destade45@gmail.com";
const TECH_STACK = ["React", "Node.js", "Express", "MongoDB", "PostgreSQL"];
---

<section 1id="hero" class="relative py-16 sm:py-24 lg:py-32 flex flex-col justify-center border-b border-[var(--color-border)]">
  <!-- Subtle background grid detail -->
  <div class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,var(--color-border)_1px,transparent_1px),linear-gradient(to_bottom,var(--color-border)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] opacity-30 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-3xl space-y-8">
    <!-- Eyebrow status line -->
    <div class="inline-flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-[var(--color-accent)] animate-pulse" aria-hidden="true"></span>
      <span class="text-label text-[var(--color-text-secondary)] tracking-widest font-mono">
        SOFTWARE DEVELOPER · COMPUTER SCIENCE GRADUATE
      </span>
    </div>

    <!-- Main Headline (H1) -->
    <h1 class="text-display font-extrabold text-[var(--color-text-primary)] tracking-tight leading-[1.1]">
      Building practical web products &amp; reliable backend systems.
    </h1>

    <!-- Supporting Description -->
    <p class="text-body text-[var(--color-text-secondary)] max-w-2xl leading-relaxed">
      Computer Science graduate focused on full-stack web development, backend architecture, and engineering reliable digital products that solve real problems.
    </p>

    <!-- Call to Action Buttons -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 pt-2">
      <a 
        href="/#projects" 
        class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[var(--radius-sm)] bg-[var(--color-accent)] px-6 font-medium text-white hover:opacity-90 transition-opacity focus-visible:outline-none"
      >
        View Projects
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>

      <a 
        href={`mailto:${CONTACT_EMAIL}`}
        class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-[var(--radius-sm)] border border-[var(--color-border)] bg-[var(--color-surface)] px-6 font-medium text-[var(--color-text-primary)] hover:border-[var(--color-text-secondary)] transition-colors focus-visible:outline-none"
      >
        Contact Me
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-text-secondary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
      </a>
    </div>

    <!-- Small Availability Metadata -->
    <div class="pt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-meta text-[var(--color-text-secondary)] border-t border-[var(--color-border)]/60">
      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span>Based in Nigeria</span>
      </div>

      <div class="hidden sm:block text-[var(--color-border)]">•</div>

      <div class="flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[var(--color-accent-text)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
        </svg>
        <span>Open to software engineering opportunities</span>
      </div>
    </div>

    <!-- Core Technology Signal -->
    <div class="flex flex-wrap items-center gap-2 text-meta text-[var(--color-text-secondary)]">
      <span class="font-medium text-[var(--color-text-primary)]">Core Stack:</span>
      {TECH_STACK.map((tech, idx) => (
        <span class="inline-flex items-center gap-2 font-mono">
          <span>{tech}</span>
          {idx < TECH_STACK.length - 1 && <span class="text-[var(--color-border)]">/</span>}
        </span>
      ))}
    </div>
  </div>
</section>
