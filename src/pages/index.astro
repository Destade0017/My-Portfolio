---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import About from '../components/About.astro';
import Skills from '../components/Skills.astro';
import { projects } from '../data/projects';
import { experiences } from '../data/experience';

const featuredProjects = projects.filter(p => p.featured);
const secondaryProjects = projects.filter(p => !p.featured);

const primaryExperiences = experiences.filter(e => !e.isSecondary);
const secondaryExperiences = experiences.filter(e => e.isSecondary);
---

<Layout 
  title="John Korede | Software Developer"
  description="John Korede is a Software Developer and Computer Science graduate specializing in full-stack web development, backend architecture, and practical digital products."
>
  <Hero />

  <!-- Selected Projects Section -->
  <section id="projects" class="py-16 sm:py-24 space-y-12 border-b border-[var(--color-border)]">
    <div class="max-w-2xl space-y-3">
      <div class="text-label text-[var(--color-accent-text)] font-mono tracking-widest">
        SELECTED WORK
      </div>
      <h2 class="text-h1 font-bold text-[var(--color-text-primary)] tracking-tight">
        Featured &amp; Built Projects
      </h2>
      <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
        A selection of full-stack web applications, backend platforms, and workflow automation systems built with a focus on reliability, performance, and clear architectural structure.
      </p>
    </div>

    <!-- Flagship Featured Projects Grid -->
    <div class="space-y-6">
      <h3 class="text-label font-mono text-[var(--color-text-secondary)] tracking-wider uppercase">
        Flagship Case Studies
      </h3>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {featuredProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>

    <!-- Secondary Projects Grid -->
    <div class="space-y-6 pt-6">
      <h3 class="text-label font-mono text-[var(--color-text-secondary)] tracking-wider uppercase">
        Other Noteworthy Projects
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {secondaryProjects.map(project => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section id="experience" class="py-16 sm:py-24 space-y-12 border-b border-[var(--color-border)]">
    <div class="max-w-2xl space-y-3">
      <div class="text-label text-[var(--color-accent-text)] font-mono tracking-widest">
        CAREER PATH
      </div>
      <h2 class="text-h1 font-bold text-[var(--color-text-primary)] tracking-tight">
        Experience
      </h2>
      <p class="text-body text-[var(--color-text-secondary)] leading-relaxed">
        Professional internships and digital operations roles contributing to web applications, reporting tools, and content workflows.
      </p>
    </div>

    <!-- Main Software / Digital Internships Timeline -->
    <div class="space-y-8 max-w-3xl">
      {primaryExperiences.map(item => (
        <ExperienceItem item={item} />
      ))}
    </div>

    <!-- Secondary Prior Work Experience -->
    {secondaryExperiences.length > 0 && (
      <div class="space-y-6 max-w-3xl pt-6 border-t border-[var(--color-border)]/60">
        <h3 class="text-label font-mono text-[var(--color-text-secondary)] tracking-wider uppercase">
          Earlier Experience
        </h3>
        <div class="space-y-6">
          {secondaryExperiences.map(item => (
            <ExperienceItem item={item} />
          ))}
        </div>
      </div>
    )}
  </section>

  <!-- About Section -->
  <About />

  <!-- Skills & Technologies Section -->
  <Skills />
</Layout>
